# ──────────────────────────────────────────────
# Azure Authentication
# ──────────────────────────────────────────────
ARM_SUBSCRIPTION_ID="your-subscription-id"
ARM_TENANT_ID="your-tenant-id"
ARM_CLIENT_ID="your-client-id"

# For service principal auth (optional, omit for interactive login)
# ARM_CLIENT_SECRET="your-client-secret"

# Set to "true" when running in GitHub Actions with OIDC
# ARM_USE_OIDC="true"

# ──────────────────────────────────────────────
# Terraform State Backend (Azure Storage)
# ──────────────────────────────────────────────
BACKEND_RESOURCE_GROUP="rg-terraform-state"
BACKEND_STORAGE_ACCOUNT="stterraformstate"
BACKEND_CONTAINER="tfstate"

# ──────────────────────────────────────────────
# Optional
# ──────────────────────────────────────────────
# TF_VERSION="1.7.0"
# AUTO_APPROVE="true"           # Skip confirmation prompts (use with caution)
# MODULE_REPO_PAT="ghp_xxxx"   # GitHub PAT for private module repos
